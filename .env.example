# Copy to .env and fill in. .env is gitignored — never commit real keys.

# ─── Voice / ASR ────────────────────────────────────────────────────────────
# ElevenLabs — Scribe v2 Realtime (always-on ASR, feeds LLM context)
ELEVENLABS_API_KEY=

# HuggingFace — needed to download PersonaPlex weights
HF_TOKEN=

# ─── LLM ────────────────────────────────────────────────────────────────────
# Anthropic — Reasoner slot extractor (Haiku)
ANTHROPIC_API_KEY=

# ─── Telephony ──────────────────────────────────────────────────────────────
# LiveKit Cloud — WebRTC + SIP routing
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Twilio — DID + SIP trunk
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# ─── Compute ────────────────────────────────────────────────────────────────
# Modal — GPU hosting for model_service
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=
