# Copy to .env and fill in. .env is gitignored — never commit real keys.

# ─── Voice / ASR ────────────────────────────────────────────────────────────
# ElevenLabs — Scribe v2 Realtime (always-on ASR, feeds LLM context)
ELEVENLABS_API_KEY=

# HuggingFace — needed to download PersonaPlex weights
HF_TOKEN=

# ─── LLM ────────────────────────────────────────────────────────────────────
# Anthropic — Reasoner slot extractor (Haiku)
ANTHROPIC_API_KEY=

# ─── Telephony ──────────────────────────────────────────────────────────────
# LiveKit Cloud — WebRTC + SIP routing
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# LiveKit Cloud — inbound SIP URI for Twilio to dial. Created once per
# project via `lk sip inbound-trunk create`. Looks like
# "<project-subdomain>.sip.livekit.cloud". The Twilio webhook returns TwiML
# that <Dial><Sip>s into sip:<room-name>@<this-uri>.
LIVEKIT_SIP_URI=

# Twilio — DID + SIP trunk
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Twilio Voice signature validation. Set to "1" to skip (dev/ngrok). Set to
# "0" or unset to enforce signature checks (prod).
TWILIO_SKIP_SIGNATURE_VALIDATION=

# Public wss:// URL Modal connects back to (control-plane). ngrok URL during
# dev. Modal's process_call.spawn(...) gets this as the backend_control_url
# kwarg. Example: wss://abc-123.ngrok.app
BACKEND_PUBLIC_WS_URL=

# Modal app + class names. Webhook resolves these via Cls.from_name to spawn
# process_call() per inbound call. Override only if app name changes.
MODAL_APP_NAME=personaplex-clio
MODAL_CLS_NAME=PersonaPlexService

# ─── Compute ────────────────────────────────────────────────────────────────
# Modal — GPU hosting for model_service
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=

# ─── Persistent live state (Supabase) ──────────────────────────────────────
# Supabase project — durable backing for live transcripts + FNOL state.
# Backend writes via the service-role key; the Next.js UI subscribes via
# realtime using the anon key (safe to expose to the browser).
#
# Setup: dashboard.supabase.com → new project → copy keys from Settings → API.
# Schema lives in db/supabase_schema.sql (apply once via SQL Editor).

# Project URL, e.g. https://abcdefghijklm.supabase.co
SUPABASE_URL=

# Public anon key — used by the browser/Next.js client to subscribe to
# realtime channels. Read-only via RLS policies.
SUPABASE_ANON_KEY=

# Service-role key — used by backend orchestrator to INSERT call/message/
# event rows. Bypasses RLS. NEVER expose to the browser. Goes into Modal
# secret `clio-backend-cfg`, not the frontend env.
SUPABASE_SERVICE_ROLE_KEY=
